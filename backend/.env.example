NODAL_ENV=dev
NODAL_HTTP_ADDR=:8080

# sqlite（默认，开箱即用）
NODAL_DB_DRIVER=sqlite
NODAL_DB_DSN=data/nodal.db
# NODAL_DB_DEBUG=false

# mysql 示例
# NODAL_DB_DRIVER=mysql
# NODAL_DB_DSN=user:pass@tcp(127.0.0.1:3306)/nodal?charset=utf8mb4&parseTime=True&loc=Local

# 生产必须替换为 >=32 位随机串
NODAL_JWT_SECRET=dev-insecure-secret-please-change
NODAL_JWT_ISSUER=nodal
NODAL_USER_TOKEN_TTL=24h
NODAL_GUEST_TOKEN_TTL=72h

NODAL_GUEST_ENABLED=true
NODAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 模型 API Key 加密密钥（32 字节的 base64 或 64 位 hex）
# 开发环境不填会从 NODAL_JWT_SECRET 派生；生产环境必须独立配置
# NODAL_ENC_KEY=
# 生成：openssl rand -base64 32

# 单次模型调用超时（默认 2m）
NODAL_LLM_TIMEOUT=2m
# 单次推演最多新增节点数（1-500，默认 50）
NODAL_INFER_MAX_NODES=50

# ===== 模块 5：知识库 / RAG =====
# 上传文件落盘目录（相对工作目录或绝对路径）
NODAL_STORAGE_DIR=data/uploads
# 单文件大小上限，字节；默认 10MB，取值 1MB–100MB
NODAL_UPLOAD_MAX_BYTES=10485760
# 文本切片长度（字符），200–4000，默认 800
NODAL_CHUNK_RUNES=800
# 相邻切片重叠字符，0 到 ChunkRunes/2，默认 100
NODAL_CHUNK_OVERLAP=100
# 向量模型：mock/embed（免 Key）或 openai/text-embedding-3-small
NODAL_EMBED_MODEL=mock/embed
# 向量维度，256–4096；必须与模型输出一致，默认 1536
NODAL_EMBED_DIM=1536
# 默认召回片段数，1–20
NODAL_RAG_TOP_K=5
# 单个画布最多临时挂载的文件数，1–20
NODAL_MOUNT_MAX_FILES=5

# ===== 模块 7：REPL 隔离沙箱 =====
# 是否开放代码执行能力
NODAL_REPL_ENABLED=true
# local：用户命名空间 + 网络/挂载/PID 隔离 + PTY；firecracker：外部 launcher
NODAL_REPL_RUNTIME=local
# 单会话硬超时，5s–30s；生产建议 30s
NODAL_REPL_TIMEOUT=30s
# 单会话内存上限（RLIMIT_AS），64–1024MB
NODAL_REPL_MEMORY_MB=256
# 全局并发会话上限，1–100
NODAL_REPL_MAX_SESSIONS=20
# 单用户并发会话上限，1–10，且不超过全局
NODAL_REPL_MAX_PER_USER=2
# 会话内 tmpfs 容量上限，8–256MB
NODAL_REPL_DISK_MB=32
# firecracker 模式必填：launcher 绝对路径（启动 microVM 并把 guest ttyd 桥到 stdio）
NODAL_REPL_FIRECRACKER_LAUNCHER=
