# ---------- 服务端 ----------
APP_ENV=development
HTTP_ADDR=:8080

# ---------- 数据库 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nodal
POSTGRES_PASSWORD=nodal_dev_pwd
POSTGRES_DB=nodal
# GORM 用的完整 DSN（容器内启动时 host 改为 postgres）
DATABASE_URL=postgres://nodal:nodal_dev_pwd@localhost:5432/nodal?sslmode=disable

# ---------- Redis ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 鉴权 ----------
# 生产环境务必替换为 32 字节以上随机串
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRE_HOURS=168

# ---------- 上传 / 向量 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
EMBEDDING_DIM=1536

# ---------- AI 默认凭据（用户也可在界面自带 Key 覆盖）----------
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# ---------- REPL 沙箱 ----------
REPL_EXEC_TIMEOUT_SEC=30
REPL_MEM_LIMIT_MB=256

# ---------- 前端 ----------
VITE_API_BASE=/api
